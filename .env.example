# ─────────────────────────────────────────────────────────────────
# ENPI LPL Monitor — Environment Variables
# ─────────────────────────────────────────────────────────────────
# LOCAL USE: copy to .env and fill in. Never commit .env to git.
# GITHUB:    add these as Repository Secrets (Settings → Secrets → Actions).
# ─────────────────────────────────────────────────────────────────

# ── ntfy push notifications (RECOMMENDED — free, instant phone alerts) ──
# 1. Install the ntfy app on your phone
# 2. Subscribe to the topic below (use a long random string for privacy)
NTFY_TOPIC=enpi-lpl-CHANGE-ME-to-a-long-random-secret-string
# NTFY_SERVER=https://ntfy.sh          # default: public ntfy server
# NTFY_TOKEN=tk_xxx                    # only if using a protected/reserved topic

# ── Email backup (optional but recommended) ──
EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                          # 465=SSL, 587=STARTTLS
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password        # Gmail: enable 2FA → App Passwords → 16-char code
# EMAIL_FROM=your-gmail@gmail.com      # defaults to SMTP_USER

# ── Monitoring targets (optional — override defaults) ──
# TARGET_WILAYAS=Alger,Tipaza,Blida,Boumerdes
# MONITOR_ALL_WILAYAS=false

# ── Dead-man's switch (optional — free at healthchecks.io) ──
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# ── Misc ──
# STATE_FILE=state.json               # defaults to state.json next to monitor.py
